# 腾讯 MaaS OpenAI 兼容接口
TENCENT_API_KEY=your_api_key
TENCENT_API_BASE_URL=https://your-api-base.example.com/v1

# 可选：部署者维护的服务清单；仅支持 HTTPS Chat Completions 兼容接口
# MODEL_SERVICES_CONFIG=/absolute/path/model_services.json
# ENTERPRISE_API_KEY=your_enterprise_key
# TENCENT_MODEL=hy3

# 第二服务：配置服务清单后使用，不会自动切换现有服务
# DEEPSEEK_API_KEY=your_deepseek_api_key

# Streamlit Cloud 可用 MODEL_SERVICES_JSON 填写服务清单 JSON 字符串，优先于本地路径。
# 清单只包含服务地址和密钥变量名，密钥另设根级环境变量。
